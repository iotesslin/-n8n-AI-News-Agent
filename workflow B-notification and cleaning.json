        "jsCode": "// 把合併節點吐出的資料整理成 SMTP 節點要的乾淨格式\nconst j = $input.all()[0].json;\nconst rd = j.recipientData || [];\nconst first = rd[0];\nconst toEmail = (first && (first.json ? first.json.allEmails : first.allEmails)) || '';\nreturn [{ json: { html: j.html, weekLabel: j.weekLabel, count: j.count, toEmail } }];"

      "parameters": {
        "jsCode": "// 將所有Approved項目彙整成 HTML 公告內容\n// 依Score高到低排序、加上星等、Category色塊、並把連結文字改成更明確的「閱讀原文 →」\nconst items = $input.all();\n\nconst sorted = [...items].sort((a, b) => (Number(b.json['Score']) || 0) - (Number(a.json['Score']) || 0));\n\n// Category色塊調色盤，依Category文字雜湊決定顏色，確保同Category顏色一致，不用手動對應每個Category名稱\nconst palette = [\n  { bg: '#E8F0FE', text: '#1967D2' },\n  { bg: '#FCE8E6', text: '#C5221F' },\n  { bg: '#E6F4EA', text: '#188038' },\n  { bg: '#FEF7E0', text: '#B06000' },\n  { bg: '#F3E8FD', text: '#8430CE' },\n  { bg: '#E0F7FA', text: '#00838F' },\n  { bg: '#FCE4EC', text: '#AD1457' }\n];\n\nfunction categoryColor(category) {\n  const str = category || '一般';\n  let hash = 0;\n  for (let i = 0; i < str.length; i++) {\n    hash = (hash * 31 + str.charCodeAt(i)) % palette.length;\n  }\n  return palette[Math.abs(hash) % palette.length];\n}\n\n// Score轉星等：10分=5顆星，每少1分少1顆星，未滿7分一律固定1顆星\nfunction scoreToStars(score) {\n  const s = Number(score) || 0;\n  const stars = Math.max(1, Math.min(5, s - 5));\n  return '★'.repeat(stars) + '☆'.repeat(5 - stars);\n}\n\nconst rows = sorted.map(i => {\n  const j = i.json;\n  const color = categoryColor(j['Category']);\n  const stars = scoreToStars(j['Score']);\n  return `\n    <tr>\n      <td style=\"padding:12px 8px;border-bottom:1px solid #e5e5e5;vertical-align:top;\">\n        <div style=\"font-weight:600;font-size:15px;margin-bottom:4px;\">\n          <a href=\"${j['Link']}\" style=\"color:#185FA5;text-decoration:none;\" target=\"_blank\">${j['Title']}</a>\n        </div>\n        <div style=\"font-size:13px;color:#555;line-height:1.6;margin-bottom:6px;\">${j['Summary']}</div>\n        <div style=\"font-size:12px;\">\n          <span style=\"background:${color.bg};color:${color.text};padding:2px 8px;border-radius:10px;font-weight:600;display:inline-block;margin-right:8px;\">${j['Category'] || '一般'}</span>\n          <span style=\"color:#F5A623;letter-spacing:1px;margin-right:8px;\">${stars}</span>\n          <a href=\"${j['Link']}\" style=\"color:#185FA5;text-decoration:none;font-weight:500;\" target=\"_blank\">閱讀原文 →</a>\n        </div>\n      </td>\n    </tr>`;\n}).join('');\n\n// 計算本次公告涵蓋的新聞區間：寄信當天往前推7天~寄信當天本身\nfunction fmt(d) {\n  const y = d.getFullYear();\n  const m = String(d.getMonth() + 1).padStart(2, '0');\n  const day = String(d.getDate()).padStart(2, '0');\n  return `${y}/${m}/${day}`;\n}\n\nconst now = new Date();\nconst rangeStart = new Date(now);\nrangeStart.setDate(now.getDate() - 7);\nconst rangeEnd = new Date(now);\nrangeEnd.setDate(now.getDate() - 0);\n\nconst weekLabel = `${fmt(rangeStart)}~${fmt(rangeEnd)}`;\n\nconst html = `\n<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:640px;margin:0 auto;\">\n  <p style=\"font-size:13px;color:#666;\">您好，\n以下整理過去一週內值得關注的重點新聞，內容經由 Gemini 篩選並聚焦於與 AI 相關之軟硬體開發、生產力工具、PC 生態等重要資訊，希望協助大家快速掌握最新技術趨勢與產業動態，作為工作及學習參考。</p>\n  <h2 style=\"font-size:18px;color:#222;\">本週新聞精選（${weekLabel}）</h2>\n  <table style=\"width:100%;border-collapse:collapse;\">${rows}</table>\n  <p style=\"font-size:12px;color:#999;margin-top:16px;\">本公告由 AI News Agent 自動彙整並經人工審核發出，僅提供內部人員參閱。</p>\n</div>`;\n\nreturn [{ json: { html, count: sorted.length, weekLabel } }];"
      },

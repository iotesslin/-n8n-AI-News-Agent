        "jsCode": "// 1. 取得從 Google Sheet 讀取到的原始資料\nlet rows = [];\n\ntry {\n    rows = $('讀取收件人清單').all();\n} catch (e) {\n    // 若節點名稱錯誤，回傳偵錯訊息\n    return { \n        allEmails: \"tess_lin@compal.com\", \n        status: \"Error: Node name '讀取收件人清單' not found\",\n        error: e.message \n    };\n}\n\n// 2. 處理ADname轉為完整 Email\nconst recipients = rows\n    .map(item => {\n        let adName = item.json.ADName;\n        if (!adName) return null; // 跳過空值\n        \n        adName = String(adName).trim(); // 去除前後空白\n        \n        // 如果內容已經包含 @，就不再重複補上，否則補上 @compal.com\n        return adName.includes('@') ? adName : `${adName}@compal.com`;\n    })\n    .filter(e => e); // 移除 null 項目\n\n// 3. 防禦性機制：若清單為空，至少回傳給 RD 管理員，確保流程不中斷\nif (recipients.length === 0) {\n    return { \n        allEmails: \"tess_lin@compal.com\", \n        count: 0,\n        status: \"Warning: Recipients list is empty\" \n    };\n}\n\n// 4. 回傳合併後的字串\nreturn {\n    allEmails: recipients.join(','),\n    count: recipients.length,\n    status: \"OK\"\n};// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.myNewField = 1;\n}\n\nreturn $input.all();"
      },

    {
      "parameters": {
        "jsCode": "// 只保留最近14天內處理過的紀錄，比新聞蒐集的7天範圍多留一週緩衝\n// 同時依「來源連結」去重，避免舊資料留下的重複項目在每次清理時被一直複製下去\nconst cutoff = Date.now() - 14 * 24 * 60 * 60 * 1000;\n\nconst withDate = items.map(item => {\n  const dateStr = item.json['處理時間'] || '';\n  const t = dateStr ? new Date(dateStr).getTime() : NaN;\n  return { item, t };\n});\n\nconst withinRange = withDate.filter(({ t }) => isNaN(t) || t >= cutoff);\n\n// 依來源連結去重，同一個連結若出現多次，保留處理時間最新的那一筆\nconst latestByLink = new Map();\nfor (const { item, t } of withinRange) {\n  const link = (item.json['來源連結'] || '').trim();\n  if (!link) {\n    // 沒有連結的資料無法去重比對，直接保留，用一個獨立key避免互相覆蓋\n    latestByLink.set(Symbol(), item);\n    continue;\n  }\n  const existing = latestByLink.get(link);\n  if (!existing) {\n    latestByLink.set(link, item);\n  } else {\n    const existingTime = new Date(existing.json['處理時間'] || 0).getTime();\n    if (isNaN(existingTime) || t > existingTime) {\n      latestByLink.set(link, item);\n    }\n  }\n}\n\nreturn Array.from(latestByLink.values());"
      },
      "id": "",
      "name": "篩選近14天",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        288
      ]
    },

    {
      "parameters": {
        "jsCode": "// 去重：items 裡同時包含「歷史紀錄」(isHistory=true) 與「本次抓到的新聞」\n// 因為兩者都先匯流進同一個合併節點才到這裡，所以保證都已經到齊，不用跨節點引用\n// 歷史紀錄來自「已處理」表單，欄位名稱是「來源連結」；本次新聞來自RSS，欄位名稱是 link/guid\nconst seenLinks = new Set();\nfor (const item of items) {\n  if (item.json.isHistory) {\n    const l = (item.json['來源連結'] || '').trim();\n    if (l) seenLinks.add(l);\n  }\n}\n\nconst uniqueByLink = new Map();\nfor (const item of items) {\n  if (item.json.isHistory) continue;\n  const link = (item.json.link || item.json.guid || '').trim();\n  if (!link) continue;\n  if (seenLinks.has(link)) continue;\n  if (!uniqueByLink.has(link)) {\n    uniqueByLink.set(link, item);\n  }\n}\nreturn Array.from(uniqueByLink.values());"
      },
      "id": "",
      "name": "去重過濾",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1328,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// 只保留過去7天內發布的新聞，並依發布日期新到舊排序\n// 沒有日期資訊的項目為避免誤刪，暫時保留（可視需要改成排除）\nconst cutoff = Date.now() - 7 * 24 * 60 * 60 * 1000;\n\nconst withDate = items.map(item => {\n  const dateStr = item.json.isoDate || item.json.pubDate || '';\n  const t = dateStr ? new Date(dateStr).getTime() : NaN;\n  return { item, t };\n});\n\nconst filtered = withDate.filter(({ t }) => isNaN(t) || t >= cutoff);\n\nfiltered.sort((a, b) => {\n  if (isNaN(a.t)) return 1;\n  if (isNaN(b.t)) return -1;\n  return b.t - a.t;\n});\n\nreturn filtered.map(({ item }) => item);"
      },
      "id": "c88f39a0-81d8-4738-8385-26ea2cbf1563",
      "name": "時間篩選（近7天）",

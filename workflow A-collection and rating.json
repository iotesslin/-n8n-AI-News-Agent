      "id": "e1845a93-65a9-4084-a0c3-21075fe6a30a",
      "name": "Gemini Ratings and Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        -128
      ]
    },
    {
      "parameters": {
        "jsCode": "// 解析 Gemini 一次回傳的 JSON 陣列，並對應回原始新聞\nconst raw = $json.candidates?.[0]?.content?.parts?.[0]?.text || '';\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet parsedArray;\ntry {\n  parsedArray = JSON.parse(cleaned);\n} catch (e) {\n  return [];\n}\n\nconst originalItems = $('Combined Batch Request').item.json.items;\n\nconst results = [];\nfor (const p of parsedArray) {\n  const original = originalItems[p.index];\n  if (!original) continue;\n  results.push({\n    json: {\n      title: p.title || original.title,\n      summary: p.summary || '',\n      category: p.category || '',\n      score: Number(p.score) || 0,\n      reason: p.reason || '',\n      link: original.link,\n      pubDate: original.pubDate || ''\n    }\n  });\n}\nreturn results;"
      },
